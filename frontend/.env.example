# ==============================================================================
# TaskPilot Frontend - Environment Variable Template (.env.example)
# ==============================================================================
# Safe template for React + Vite. Duplicate as .env or .env.local for development:
#
#   Bash:       cp .env.example .env
#   PowerShell: Copy-Item .env.example -Destination .env
#
# Vite requires public environment variables to be prefixed with 'VITE_'.
# ==============================================================================

# Backend REST API Base URL
VITE_API_BASE_URL=http://localhost:8000/api

# Application Display Brand Name
VITE_APP_NAME="TaskPilot"

# Feature Flags
VITE_ENABLE_AI_FEATURES=true
