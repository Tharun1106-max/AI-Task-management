# ==============================================================================
# TaskPilot Backend - Environment Variable Template (.env.example)
# ==============================================================================
# Safe, sanitized configuration template. Duplicate this file as .env and populate
# with your active credentials for local development or production deployment:
#
#   Bash:       cp .env.example .env
#   PowerShell: Copy-Item .env.example -Destination .env
#
# IMPORTANT: NEVER commit the actual .env file containing real secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Network Server Configuration
# ------------------------------------------------------------------------------
# Name and version of the service
APP_NAME=TaskPilot
APP_VERSION=1.0.0

# Network host binding and listening port
HOST=0.0.0.0
PORT=8000

# Runtime environment: 'development', 'staging', or 'production'
ENVIRONMENT=development

# Enable FastAPI interactive Swagger docs and debug tracebacks (set to false in production)
DEBUG=true

# Primary client origin for web frontend
FRONTEND_URL=http://localhost:3000

# Allowed Cross-Origin Resource Sharing (CORS) origins (formatted as JSON array or comma-separated string)
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# 2. Database Configuration (MongoDB)
# ------------------------------------------------------------------------------
# Option A: Local MongoDB (Docker or local service)
#   MONGO_URI=mongodb://localhost:27017
#
# Option B: MongoDB Atlas Managed Cloud Cluster (with SSL and replica sets)
#   MONGO_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/?retryWrites=true&w=majority&appName=TaskPilot
MONGO_URI=mongodb://localhost:27017

# Target database name
MONGO_DB_NAME=taskpilot_db

# Connection pool sizing parameters
MONGO_MIN_POOL_SIZE=10
MONGO_MAX_POOL_SIZE=50

# ------------------------------------------------------------------------------
# 3. Security & Cryptographic Authentication (JWT)
# ------------------------------------------------------------------------------
# Cryptographically secure 256-bit secret key for signing and verifying JWT tokens.
# Generate a new 256-bit secret using one of the following commands:
#   OpenSSL:    openssl rand -hex 32
#   Python:     python -c "import secrets; print(secrets.token_hex(32))"
#   PowerShell: -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Minimum 0 -Maximum 256) })
JWT_SECRET=your_256_bit_secure_jwt_secret_key_minimum_32_characters_long

# Cryptographic signing algorithm
ALGORITHM=HS256

# Access token lifespan in minutes (1440 minutes = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Refresh token lifespan in days
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 4. AI & LLM Acceleration (Google Gemini)
# ------------------------------------------------------------------------------
# Obtain your free API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Primary inference model and embedding model
# Options: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=["gemini-2.0-flash", "gemini-1.5-flash", "gemini-1.5-pro"]
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Sampling temperature for deterministic JSON output (0.0 to 1.0)
GEMINI_TEMPERATURE=0.2

# Sliding window rate limiter limit (maximum requests per minute per user/IP)
AI_RATE_LIMIT_PER_MINUTE=30

# Maximum cumulative tokens permitted per user per UTC day
AI_DAILY_TOKEN_QUOTA=50000

# ------------------------------------------------------------------------------
# 5. File Uploads & RAG Ingestion Limits
# ------------------------------------------------------------------------------
# Maximum file size permitted for technical specifications and architecture docs (in MB)
MAX_FILE_SIZE_MB=10

# Permitted MIME file extensions (JSON array or comma-separated)
ALLOWED_EXTENSIONS=[".pdf", ".txt", ".md"]
